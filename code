#include <Wire.h> #include <Adafruit_INA226.h> #include <OneWire.h> #include <DallasTemperature.h> // Sensor pins #define ONE_WIRE_BUS 4 // DS18B20 data pin Adafruit_INA226 ina226; OneWire oneWire(ONE_WIRE_BUS); DallasTemperature sensors(&oneWire); void setup() { Serial.begin(115200); Serial.println("Initializing sensors..."); // Initialize INA226 if (!ina226.begin()) { Serial.println("Couldn't find INA226"); while (1); } ina226.configure(INA226_AVERAGES_1, INA226_BUS_CONV_TIME_1100US, INA226_SHUNT_CONV_TIME_1100US, INA226_MODE_SHUNT_BUS_CONTINUOUS); // Initialize DS18B20 sensors.begin(); Serial.println("Sensors initialized."); } void loop() { // Read temperature sensors.requestTemperatures(); float tempC = sensors.getTempCByIndex(0); Serial.print("Temperature: "); Serial.print(tempC); Serial.println(" °C"); // Read current and voltage float busVoltage = ina226.getBusVoltage_V(); float current_mA = ina226.getCurrent_mA(); Serial.print("Bus Voltage: "); Serial.print(busVoltage); Serial.println(" V"); Serial.print("Current: "); Serial.print(current_mA); Serial.println(" mA"); delay(2000); // 2 second delay }
